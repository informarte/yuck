//| mill-version: 1.0.6-jvm
//| mill-jvm-version: temurin:21
//| mvnDeps:
//| - "com.lihaoyi::mill-contrib-buildinfo:$MILL_VERSION"
//| - "com.goyeau::mill-scalafix::0.6.0"

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.contrib.buildinfo.BuildInfo
import mill.scalalib.*

object yuck extends ScalaModule with BuildInfo with ScalafixModule {

    def git(args: String*) = os.proc("git" :: args.toList).call().out.lines().head
    def gitCommitHash = Task.Input {git("rev-parse", "HEAD")}
    def gitCommitDate = Task {git("log", "-1", "--pretty=format:%cd", "--date=format:%Y%m%d")}
    def gitBranch = Task {git("rev-parse", "--abbrev-ref", "HEAD")}
    def shortVersion = Task {gitCommitDate()}
    def longVersion = Task {
        "%s-%s-%s".format(gitCommitDate(), gitBranch().replaceAll("/", "-"), gitCommitHash().take(8))}
    def version = Task {if (gitBranch() == "master") shortVersion() else longVersion()}

    override def buildInfoPackageName = "yuck"
    override def buildInfoMembers = Seq(
        BuildInfo.Value("gitBranch", gitBranch()),
        BuildInfo.Value("gitCommitDate", gitCommitDate()),
        BuildInfo.Value("gitCommitHash", gitCommitHash()),
        BuildInfo.Value("version", version()))
    override def buildInfoStaticCompiled = true

    override def scalaVersion = "3.7.4"
    override def moduleDir = super.moduleDir / ".."
    override def resources = Task { Seq.empty[PathRef] }
    override def sources = Task.Sources {moduleDir / "src" / "main"}
    override def javacOptions = Seq("-source", "11", "-target", "11")
    override def scalacOptions = Seq("-release", "11", "-deprecation", "-unchecked", "-feature", "-Wunused:imports", "-new-syntax")

    override def mvnDeps = Seq(
        mvn"io.spray::spray-json:1.3.6".withDottyCompat(this.scalaVersion()),
        mvn"com.conversantmedia:rtree:1.0.5",
        mvn"com.github.scopt::scopt:4.1.0",
        mvn"com.lihaoyi::fastparse:3.1.1",
        mvn"it.unimi.dsi:fastutil-core:8.5.15",
        mvn"org.jgrapht:jgrapht-core:1.5.2"
    )

    val basicJvmConfiguration = Seq(
        "-Djava.lang.Integer.IntegerCache.high=10000",
        "-Djava.util.logging.manager=yuck.util.logging.LogManager",
        "-XX:+UseParallelGC")
    val jvmHeapSize = Option(System.getenv("YUCK_HEAP_SIZE")).getOrElse("2G")
    val jvmConfiguration = Seq("-Xmx%s".format(jvmHeapSize)) ++ basicJvmConfiguration
    override def forkArgs = jvmConfiguration

    override def mainClass = Some("yuck.flatzinc.runner.FlatZincRunner")

    def fullClasspath = Task {(localClasspath() ++ upstreamAssemblyClasspath()).map(_.path)}
    def fullClasspathAsString = Task {fullClasspath().mkString(":")}

    object test extends ScalaTests with ScalafixModule {

        override def moduleDir = super.moduleDir / ".."
        override def resources = Task { Seq.empty[PathRef] }
        override def sources = Task.Sources {moduleDir / "src" / "test"}

        val junitVersion = "6.0.1"

        override def mvnDeps = Seq(
            mvn"org.jgrapht:jgrapht-io:1.5.2",
            mvn"org.junit.jupiter:junit-jupiter-api:$junitVersion",
            mvn"org.junit.jupiter:junit-jupiter-engine:$junitVersion",
            mvn"org.junit.jupiter:junit-jupiter-params:$junitVersion",
            mvn"org.junit.platform:junit-platform-launcher:$junitVersion",
            mvn"org.junit.platform:junit-platform-suite-api:$junitVersion",
            mvn"org.junit.platform:junit-platform-suite-engine:$junitVersion",
            mvn"org.mockito:mockito-core:3.12.4"
        )

        override def testFramework = "com.novocode.junit.JUnitFramework"

        val jvmHeapSize = Option(System.getenv("YUCK_TEST_HEAP_SIZE")).getOrElse("2G")
        val jvmConfiguration =
            Seq(
                "-Xmx%s".format(jvmHeapSize),
                "-XX:+AggressiveHeap",
                "-Djunit.jupiter.testinstance.lifecycle.default=per_method",
                "-Djunit.jupiter.execution.parallel.enabled=true",
                "-Djunit.jupiter.execution.parallel.mode.default=same_thread",
                "-Djunit.jupiter.execution.parallel.mode.classes.default=concurrent",
                "-Djunit.jupiter.execution.parallel.config.strategy=fixed",
                "-Djunit.jupiter.execution.parallel.config.fixed.parallelism=%d".format(
                    Option(System.getenv("YUCK_TEST_NUMBER_OF_THREADS"))
                        .map(_.toInt)
                        .getOrElse(Runtime.getRuntime.availableProcessors))
            ) ++
            basicJvmConfiguration
        override def forkArgs = jvmConfiguration

        override def mainClass = Some("yuck.test.util.YuckTestRunner")

        def fullClasspath = Task {(localClasspath() ++ upstreamAssemblyClasspath()).map(_.path)}
        def fullClasspathAsString = Task {fullClasspath().mkString(":")}
    }

    def documentation = Task.Source {moduleDir / "doc"}
    def miniZincBindings = Task.Source {moduleDir / "resources" / "mzn" / "lib" / "yuck"}
    def miniZincSolverConfigurationTemplate = Task.Source {moduleDir / "resources" / "mzn" / "yuck.msc.in"}
    def unixStartScriptTemplate = Task.Source {moduleDir / "resources" / "bin" / "yuck.in"}
    def winStartScriptTemplate = Task.Source {moduleDir / "resources" / "bin" / "yuck.bat.in"}
    def debianControlFileTemplate = Task.Source {moduleDir / "resources" / "debian" / "control.in"}

    def corePackage = Task {
        val packageName = "yuck-".concat(version())
        val packageDir = Task.dest / packageName
        os.remove.all(packageDir)
        for (dependency <- upstreamAssemblyClasspath().map(_.path)) {
            os.copy.into(dependency, packageDir / "lib", createFolders = true, copyAttributes = true)
        }
        val yuckJarName = packageName.concat(".jar")
        os.copy(jar().path, packageDir / "lib" / yuckJarName, createFolders = true, copyAttributes = true)
        os.copy(documentation().path, packageDir / "doc", createFolders = true, copyAttributes = true)
        os.copy(miniZincBindings().path, packageDir / "mzn" / "lib", createFolders = true, copyAttributes = true)
        val classPathComponents = (upstreamAssemblyClasspath().iterator.map(_.path.last).toSeq :+ yuckJarName)
        val unixClassPath = classPathComponents.map(jarName => "$LIB_DIR/".concat(jarName)).mkString(":")
        val basicMapping = Map("#YUCK_JAVA_OPTS#" -> basicJvmConfiguration.mkString(" "), "#MAIN_CLASS#" -> mainClass().get)
        fillTemplateIn(
            unixStartScriptTemplate().path,
            packageDir / "bin" / "yuck",
            basicMapping + ("#CLASS_PATH#" -> unixClassPath))
        makeExecutable(packageDir / "bin" / "yuck")
        val winClassPath = classPathComponents.map(jarName => "%LIB_DIR%\\".concat(jarName)).mkString(";")
        fillTemplateIn(
            winStartScriptTemplate().path,
            packageDir / "bin" / "yuck.bat",
            basicMapping + ("#CLASS_PATH#" -> winClassPath))
        PathRef(packageDir)
    }

    def universalPackage = Task {
        val packageName = "yuck-".concat(version())
        val packageDir = Task.dest / packageName
        os.remove.all(packageDir)
        os.copy(corePackage().path, packageDir, createFolders = true, copyAttributes = true)
        fillTemplateIn(
            miniZincSolverConfigurationTemplate().path,
            packageDir / "mzn" / "yuck.msc",
            Map("#VERSION#" -> version(), "#EXE_PATH#" -> "../bin/yuck", "#MZN_LIB_PATH#" -> "lib"))
        val archiveName = packageName.concat(".zip")
        os.proc("zip", "-r", archiveName, packageName).call(cwd = Task.dest)
        PathRef(Task.dest / archiveName)
    }

    def debianPackage = Task {
        val packageName = "yuck-".concat(version())
        val packageDir = Task.dest / packageName
        os.remove.all(packageDir)
        os.copy(corePackage().path, packageDir / "usr" / "share" / "yuck", createFolders = true, copyAttributes = true)
        fillTemplateIn(
            miniZincSolverConfigurationTemplate().path,
            packageDir / "usr" / "share" / "minizinc" / "solvers" / "yuck.msc",
            Map("#VERSION#" -> version(), "#EXE_PATH#" -> "/usr/bin/yuck", "#MZN_LIB_PATH#" -> "/usr/share/yuck/mzn/lib"))
        fillTemplateIn(
            debianControlFileTemplate().path,
            packageDir / "DEBIAN" / "control",
            Map("#VERSION#" -> version()))
        os.makeDir.all(packageDir / "usr" / "bin")
        os.symlink(packageDir / "usr" / "bin" / "yuck", os.Path("/usr/share/yuck/bin/yuck"))
        os.proc("dpkg-deb", "--build", packageName).call(cwd = Task.dest)
        PathRef(Task.dest / (packageName.concat(".deb")))
    }

    private def fillTemplateIn(template: os.Path, target: os.Path, mapping: Map[String, String]): Unit = {
        os.write.append(
            target,
            mapping.foldLeft(os.read(template))({case (s, (k, v)) => s.replace(k, v)}),
            createFolders = true)
    }

    private def makeExecutable(path: os.Path): Unit = {
        import java.nio.file.Files
        import java.nio.file.attribute.PosixFilePermission
        val perms = Files.getPosixFilePermissions(path.toNIO)
        perms.add(PosixFilePermission.GROUP_EXECUTE)
        perms.add(PosixFilePermission.OWNER_EXECUTE)
        perms.add(PosixFilePermission.OTHERS_EXECUTE)
        Files.setPosixFilePermissions(path.toNIO, perms)
    }

}
